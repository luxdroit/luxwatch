# PORT: Serwer nasłuchuje domyślnie na porcie 3000
PORT=3000

# STORAGE_DIR: Katalog przechowywania bazy SQLite, okładek oraz plików wideo (wiele GB)
# Wskazówka: na VPS lub NAS podłącz tutaj osobny szybki dysk, np. /mnt/anime-storage
STORAGE_DIR=./storage

# SESSION_SECRET: Losowy tajny klucz HMAC do podpisywania sesji (opcjonalne - generowane automatycznie jeśli puste)
SESSION_SECRET=
